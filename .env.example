# Slack App Credentials (get from https://api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Your server's public HTTPS URL (ngrok for dev, real domain for prod)
SLACK_REDIRECT_BASE_URL=https://5237-2401-4900-88f6-22fc-bd37-aa61-6999-d2e7.ngrok-free.app/api/slack/callback

# Token encryption (generate with: ./scripts/generate-encryption-key.sh)
TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://localhost:5432/yourapp

# App
APP_SECRET_KEY=
PORT=3000

# Frontend OAuth callback URI (must exactly match Slack OAuth redirect URL)
# Example: https://xxxx.ngrok-free.app/oauth/slack/callback
NEXT_PUBLIC_SLACK_REDIRECT_URI=
