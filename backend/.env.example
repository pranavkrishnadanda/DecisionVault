# DecisionVault Environment Configuration
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=decisionvault
DB_USER=dvuser
DB_PASSWORD=dvpass
DB_HOST=localhost
DB_PORT=5432

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Slack OAuth Credentials (server-side only)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_SCOPES=channels:read,channels:history,groups:read,groups:history,chat:write,users:read

# Public HTTPS URL for Slack callback/events
SLACK_REDIRECT_BASE_URL=https://xxxx.ngrok-free.app

# Encrypts Slack bot tokens at rest
TOKEN_ENCRYPTION_KEY=
